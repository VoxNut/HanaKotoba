# Backend Environment Variables

# Security
SECRET_KEY=django-insecure-dev-key-change-in-production-12345
DEBUG=True

# Database - Use SQLite for development (no setup needed)
# Comment this line to use SQLite:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hanakotoba

# For PostgreSQL, uncomment above and set your credentials
# For SQLite (default), leave DATABASE_URL commented out

# AI Features - Choose one or both

# Google Gemini API (RECOMMENDED - FREE TIER)
# Get your free API key at: https://aistudio.google.com/app/apikey
# Free tier: 1M requests/month, no credit card needed
GEMINI_API_KEY=AIzaSyDzPnsjX81RaXLt3oIClkOhAM9Dgw7z1kY
GEMINI_MODEL=gemini-pro

# OpenAI API (OPTIONAL - Requires paid account)
# Only needed if you want premium features beyond mnemonics
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Celery & Redis (Optional - for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
