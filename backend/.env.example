# Backend Environment Variables

# Security
SECRET_KEY=django-insecure-dev-key-change-in-production-12345
DEBUG=True

# Database - Use SQLite for development (no setup needed)
# Comment this line to use SQLite:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hanakotoba

# For PostgreSQL, uncomment above and set your credentials
# For SQLite (default), leave DATABASE_URL commented out

# AI Features
OPENAI_API_KEY=your-openai-api-key-here

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI Settings
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500
